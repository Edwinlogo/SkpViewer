{
  "name": "skp-xr-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visor WebXR offline (PWA) para archivos SketchUp (.skp, .glb, .gltf, .dae, .kmz, .obj) con passthrough, transformaciones 3D, capas, elementos y escenas animadas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:demo": "node scripts/generate-demo-skp.mjs",
    "deploy": "npm run build && node scripts/deploy-gh-pages.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.511.0",
    "openskp": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.3"
  }
}
